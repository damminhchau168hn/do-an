  "lessons": [
    { "id": "l1", "lesson_id": "l1", "session_id": "s1", "title": "Danh sách liên kết đơn", "content": "Khái niệm, cài đặt và thao tác cơ bản trên danh sách liên kết đơn.", "content_type": "text", "order_index": 1, "estimated_minutes": 20, "status": "published", "created_by": "u2", "created_at": "2025-09-06T02:00:00.000Z", "updated_at": "2025-09-06T02:00:00.000Z" },
    { "id": "l2", "lesson_id": "l2", "session_id": "s1", "title": "Danh sách liên kết đôi", "content": "So sánh với danh sách liên kết đơn và các thao tác chèn/xóa hai chiều.", "content_type": "text", "order_index": 2, "estimated_minutes": 20, "status": "published", "created_by": "u2", "created_at": "2025-09-06T02:00:00.000Z", "updated_at": "2025-09-06T02:00:00.000Z" },
    { "id": "l3", "lesson_id": "l3", "session_id": "s1", "title": "Ngăn xếp (Stack)", "content": "Nguyên tắc LIFO, cài đặt bằng mảng và danh sách liên kết.", "content_type": "text", "order_index": 3, "estimated_minutes": 18, "status": "published", "created_by": "u2", "created_at": "2025-09-07T02:00:00.000Z", "updated_at": "2025-09-07T02:00:00.000Z" },
    { "id": "l4", "lesson_id": "l4", "session_id": "s1", "title": "Hàng đợi (Queue)", "content": "Nguyên tắc FIFO, cài đặt hàng đợi vòng.", "content_type": "text", "order_index": 4, "estimated_minutes": 18, "status": "published", "created_by": "u2", "created_at": "2025-09-07T02:00:00.000Z", "updated_at": "2025-09-07T02:00:00.000Z" },
    { "id": "l5", "lesson_id": "l5", "session_id": "s2", "title": "Khái niệm cây tổng quát", "content": "Định nghĩa cây, nút gốc, nút lá, độ sâu, độ cao.", "content_type": "text", "order_index": 1, "estimated_minutes": 15, "status": "published", "created_by": "u2", "created_at": "2025-09-13T02:00:00.000Z", "updated_at": "2025-09-13T02:00:00.000Z" },
    {
      "id": "l6",
      "lesson_id": "l6",
      "session_id": "s2",
      "title": "Cây nhị phân tìm kiếm (BST)",
      "content": "Cây nhị phân tìm kiếm là cấu trúc dữ liệu dạng cây trong đó mỗi nút có tối đa hai nút con, và với mọi nút: giá trị các nút bên trái nhỏ hơn nút cha, giá trị các nút bên phải lớn hơn nút cha.\n\nBa thao tác cơ bản:\n- Tìm kiếm — so sánh và rẽ nhánh trái/phải, độ phức tạp trung bình O(log n).\n- Chèn — tìm vị trí phù hợp theo tính chất BST rồi thêm nút lá mới.\n- Xóa — xử lý 3 trường hợp: nút lá, nút có 1 con, nút có 2 con.\n\nVì sao độ cân bằng quan trọng? Nếu dữ liệu được chèn theo thứ tự đã sắp xếp, BST suy biến thành danh sách liên kết — độ phức tạp tìm kiếm rơi về O(n). Đây là lý do bài tiếp theo giới thiệu cây AVL tự cân bằng.",
      "content_type": "text",
      "order_index": 2,
      "estimated_minutes": 25,
      "status": "published",
      "created_by": "u2",
      "created_at": "2025-09-14T02:00:00.000Z",
      "updated_at": "2025-09-14T02:00:00.000Z"
    },
    { "id": "l7", "lesson_id": "l7", "session_id": "s2", "title": "Cây cân bằng AVL", "content": "Hệ số cân bằng, các phép xoay đơn/kép.", "content_type": "text", "order_index": 3, "estimated_minutes": 25, "status": "published", "created_by": "u2", "created_at": "2025-09-14T02:00:00.000Z", "updated_at": "2025-09-14T02:00:00.000Z" },
    { "id": "l8", "lesson_id": "l8", "session_id": "s2", "title": "Duyệt cây (DFS/BFS)", "content": "Duyệt theo chiều sâu (pre/in/post-order) và theo chiều rộng.", "content_type": "text", "order_index": 4, "estimated_minutes": 20, "status": "published", "created_by": "u2", "created_at": "2025-09-15T02:00:00.000Z", "updated_at": "2025-09-15T02:00:00.000Z" }
  ],

  "questions": [
    { "id": "q1", "question_id": "q1", "session_id": "s1", "content": "Ngăn xếp (Stack) hoạt động theo nguyên tắc nào?", "options": ["LIFO — vào sau ra trước", "FIFO — vào trước ra trước", "Ngẫu nhiên", "Theo độ ưu tiên"], "correct_answer": 0, "explanation": "Stack tuân theo nguyên tắc LIFO (Last In, First Out) — phần tử được thêm vào sau cùng sẽ được lấy ra đầu tiên, giống chồng đĩa.", "difficulty": "easy", "created_by": "u2", "created_at": "2025-09-08T02:00:00.000Z", "updated_at": "2025-09-08T02:00:00.000Z" },
    { "id": "q2", "question_id": "q2", "session_id": "s1", "content": "Thao tác nào KHÔNG phải là thao tác cơ bản của Hàng đợi (Queue)?", "options": ["peek()", "sort() — sắp xếp toàn bộ hàng đợi", "enqueue()", "dequeue()"], "correct_answer": 1, "explanation": "Queue chuẩn chỉ hỗ trợ enqueue, dequeue và peek. sort() không phải thao tác cơ bản vì nó phá vỡ thứ tự FIFO của cấu trúc.", "difficulty": "medium", "created_by": "u2", "created_at": "2025-09-08T02:00:00.000Z", "updated_at": "2025-09-08T02:00:00.000Z" },
    { "id": "q3", "question_id": "q3", "session_id": "s2", "content": "Trong cây nhị phân tìm kiếm (BST), phần tử nhỏ nhất nằm ở đâu?", "options": ["Nút gốc của cây", "Nút lá tận cùng bên phải", "Nút lá tận cùng bên trái", "Không xác định được"], "correct_answer": 2, "explanation": "Phần tử nhỏ nhất trong BST luôn nằm ở nút lá tận cùng bên trái.", "difficulty": "medium", "created_by": "u2", "created_at": "2025-09-15T02:00:00.000Z", "updated_at": "2025-09-15T02:00:00.000Z" },
    { "id": "q4", "question_id": "q4", "session_id": "s2", "content": "Độ phức tạp trung bình của thao tác tìm kiếm trên BST cân bằng với n phần tử là gì?", "options": ["O(log n)", "O(n)", "O(n log n)", "O(1)"], "correct_answer": 0, "explanation": "Với cây cân bằng, độ phức tạp trung bình của tìm kiếm là O(log n).", "difficulty": "medium", "created_by": "u2", "created_at": "2025-09-15T02:00:00.000Z", "updated_at": "2025-09-15T02:00:00.000Z" },
    { "id": "q5", "question_id": "q5", "session_id": "s2", "content": "Khi nào một BST suy biến thành danh sách liên kết, khiến độ phức tạp tìm kiếm là O(n)?", "options": ["Khi cây có số lẻ phần tử", "Khi dữ liệu được chèn theo thứ tự đã sắp xếp", "Khi cây được xóa nhiều lần", "Không bao giờ xảy ra"], "correct_answer": 1, "explanation": "Nếu dữ liệu được chèn theo thứ tự đã sắp xếp, BST suy biến thành một danh sách liên kết.", "difficulty": "hard", "created_by": "u2", "created_at": "2025-09-15T02:00:00.000Z", "updated_at": "2025-09-15T02:00:00.000Z" },
    { "id": "q6", "question_id": "q6", "session_id": "s2", "content": "Chọn tất cả các thuật toán duyệt cây hợp lệ.", "options": ["Pre-order", "Post-order", "Quick-order", "In-order"], "correct_answer": [0, 1, 3], "explanation": "Pre-order, In-order và Post-order là các thuật toán duyệt cây hợp lệ; Quick-order không tồn tại.", "difficulty": "medium", "created_by": "u2", "created_at": "2025-09-16T02:00:00.000Z", "updated_at": "2025-09-16T02:00:00.000Z" },
    { "id": "q7", "question_id": "q7", "session_id": "s3", "content": "Độ phức tạp thời gian của thuật toán Dijkstra với heap nhị phân là gì?", "options": ["O(V^2)", "O((V+E) log V)", "O(E log E)", "O(V log E)"], "correct_answer": 1, "explanation": "Với cài đặt bằng heap nhị phân, độ phức tạp của Dijkstra là O((V+E) log V).", "difficulty": "hard", "created_by": "u2", "created_at": "2025-09-21T02:00:00.000Z", "updated_at": "2025-09-21T02:00:00.000Z" },
    { "id": "q8", "question_id": "q8", "session_id": "s4", "content": "Bài toán cái túi 0/1 thuộc nhóm kỹ thuật nào?", "options": ["Chia để trị", "Quy hoạch động", "Tham lam", "Vét cạn"], "correct_answer": 1, "explanation": "Bài toán cái túi 0/1 là bài toán kinh điển được giải bằng quy hoạch động.", "difficulty": "easy", "created_by": "u2", "created_at": "2025-09-28T02:00:00.000Z", "updated_at": "2025-09-28T02:00:00.000Z" }
